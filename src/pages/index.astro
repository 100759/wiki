---
import Base from "../layouts/Base.astro";
import { pathToSlug } from "../lib/ids";
import { getSession } from "../lib/session";
import { getStore } from "../lib/storage";

export const prerender = false;

const store = getStore();
const pages = await store.listPages();
const session = getSession(Astro.cookies);
const canEdit = Boolean(session && session.role !== "viewer");

const groups = new Map<string, typeof pages>();
for (const page of pages) {
  const rel = page.path.replace(/^content\//, "").replace(/\.md$/, "");
  const dir = rel.includes("/") ? rel.split("/").slice(0, -1).join("/") : "";
  const list = groups.get(dir) ?? [];
  list.push(page);
  groups.set(dir, list);
}
---

<Base title="全部页面" sidebar={false}>
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold">全部页面</h1>
      <p class="mt-1 text-sm text-stone-500">
        共 {pages.length} 页。读者免登录阅读；编辑与保存需要登录。
      </p>
    </div>
    {
      canEdit && (
        <button
          type="button"
          id="new-page"
          class="rounded-md bg-ink px-3 py-1.5 text-sm text-white hover:bg-black"
        >
          新建页面
        </button>
      )
    }
  </div>

  {
    pages.length === 0 ? (
      <p class="rounded-lg border border-dashed border-stone-300 p-8 text-center text-stone-500">
        还没有页面。登录后点“新建页面”开始。
      </p>
    ) : (
      <div class="space-y-5">
        {[...groups.entries()].map(([dir, list]) => (
          <section>
            {dir && <h2 class="mb-2 text-xs font-medium uppercase tracking-wide text-stone-400">{dir}/</h2>}
            <ul class="divide-y divide-stone-200 overflow-hidden rounded-lg border border-stone-200 bg-white">
              {list.map((page) => (
                <li class="flex items-center gap-3 px-4 py-3">
                  <div class="min-w-0 flex-1">
                    <a href={`/w/${pathToSlug(page.path)}`} class="font-medium hover:text-blue-700">
                      {page.title}
                    </a>
                    <div class="truncate text-xs text-stone-400">{page.path}</div>
                  </div>
                  <span class="rounded bg-stone-100 px-1.5 py-0.5 text-[11px] text-stone-500">
                    {page.acl.join(" / ")}
                  </span>
                  {canEdit && (
                    <a
                      href={`/edit?path=${encodeURIComponent(page.path)}`}
                      class="text-xs text-stone-500 hover:text-ink"
                    >
                      编辑
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )
  }

  {
    canEdit && (
      <script is:inline>
        document.getElementById("new-page")?.addEventListener("click", async function () {
          const path = window.prompt("新页面路径（例如 content/guide/faq.md）", "content/new-page.md");
          if (!path) return;
          const title = window.prompt("页面标题", "新页面") || "新页面";
          const response = await fetch("/api/pages", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ action: "create", path, title }),
          });
          const result = await response.json();
          if (result.ok) location.href = "/edit?path=" + encodeURIComponent(path);
          else window.alert(result.message || "创建失败");
        });
      </script>
    )
  }
</Base>
