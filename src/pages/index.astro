---
import Base from "../layouts/Base.astro";
import { pathToSlug } from "../lib/ids";
import { getSession } from "../lib/session";
import { setPageCache } from "../lib/cache";
import { getStore } from "../lib/storage";

export const prerender = false;
setPageCache(Astro.cookies, Astro.response.headers, { maxAge: 180, swr: 1800 });

const store = getStore();
const pages = await store.listPages();
const session = getSession(Astro.cookies);
const canEdit = Boolean(session && session.role !== "viewer");

const groups = new Map<string, typeof pages>();
for (const page of pages) {
  const rel = page.path.replace(/^content\//, "").replace(/\.md$/, "");
  const dir = rel.includes("/") ? rel.split("/").slice(0, -1).join("/") : "";
  const list = groups.get(dir) ?? [];
  list.push(page);
  groups.set(dir, list);
}
---

<Base title="全部页面" sidebar={false}>
  <section class="mx-auto max-w-content pb-12 pt-20">
    <h1 class="text-[2.8rem] font-light leading-[1.1] tracking-tight text-ink">所有页面</h1>
    <div class="mt-4 flex flex-wrap items-center gap-4">
      <p class="text-[13px] text-graphite">{pages.length} 个页面 · 读免登录，改要登录</p>
      {
        canEdit && (
          <button
            type="button"
            id="new-page"
            class="border border-ink px-4 py-1.5 text-[12px] uppercase tracking-label text-ink transition-colors hover:bg-ink hover:text-paper"
          >
            新建页面
          </button>
        )
      }
    </div>
  </section>

  {
    pages.length === 0 ? (
      <p class="max-w-content border-t border-hairline py-16 text-[13px] text-stone-400">
        还没有页面。登录后点“新建页面”开始。
      </p>
    ) : (
      <div class="mx-auto max-w-content pb-10">
        {[...groups.entries()].map(([dir, list]) => (
          <section class="mt-10 first:mt-0">
            {dir && <p class="label mb-3">{dir}</p>}
            <ul class="border-t border-hairline">
              {list.map((page) => (
                <li class="group flex items-baseline gap-4 border-b border-hairline py-4">
                  <a
                    href={`/w/${pathToSlug(page.path)}`}
                    class="text-[15px] text-ink transition-colors group-hover:underline"
                  >
                    {page.title}
                  </a>
                  <span class="label ml-auto hidden truncate sm:block">{page.path}</span>
                  {canEdit && (
                    <a
                      href={`/edit?path=${encodeURIComponent(page.path)}`}
                      class="text-[12px] text-graphite transition-colors hover:text-ink"
                    >
                      编辑
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )
  }

  {
    canEdit && (
      <script is:inline data-astro-rerun>
        document.getElementById("new-page")?.addEventListener("click", async function () {
          const path = window.prompt("新页面路径（例如 content/guide/faq.md）", "content/new-page.md");
          if (!path) return;
          const title = window.prompt("页面标题", "新页面") || "新页面";
          const response = await fetch("/api/pages", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ action: "create", path, title }),
          });
          const result = await response.json();
          if (result.ok) location.href = "/edit?path=" + encodeURIComponent(path);
          else window.alert(result.message || "创建失败");
        });
      </script>
    )
  }
</Base>
