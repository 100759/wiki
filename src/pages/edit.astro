---
import Base from "../layouts/Base.astro";
import Editor from "../components/editor/Editor";
import { normalizeContentPath, pageId, pathToSlug } from "../lib/ids";
import { getSession } from "../lib/session";
import { getStore } from "../lib/storage";

export const prerender = false;

const rawPath = Astro.url.searchParams.get("path") ?? "content/index.md";
let contentPath: string;
try {
  contentPath = normalizeContentPath(rawPath);
} catch {
  return Astro.redirect("/");
}

const store = getStore();
const session = getSession(Astro.cookies);
if (!session) {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
}
if (session.role === "viewer") {
  return Astro.redirect(`/w/${pathToSlug(contentPath)}`);
}

const found = await store.getPageByPath(contentPath);

const page = found ?? {
  id: pageId(contentPath),
  path: contentPath,
  title: "",
  markdown: "",
  sha: "",
  updatedAt: new Date().toISOString(),
  updatedBy: session.name,
  acl: ["admin", "editor"],
  order: 100,
  parent: null,
};

const history = found ? await store.listHistory(contentPath, 10) : [];
---

<Base title={found ? `编辑：${found.title}` : "新建页面"} activePath={contentPath}>
  <div class="mb-2 flex flex-wrap items-center gap-4 text-[12px] text-graphite">
    <span class="label">{contentPath}</span>
    {
      found && (
        <span class="flex items-center gap-4">
          <button type="button" data-rename class="transition-colors hover:text-ink">重命名</button>
          <button type="button" data-delete class="text-stone-400 transition-colors hover:text-red-600">
            删除
          </button>
        </span>
      )
    }
  </div>

  <Editor client:load initial={page} user={session} history={history} />

  {
    found && (
      <script define:vars={{ contentPath }} is:inline data-astro-rerun>
        async function callPages(payload) {
          const response = await fetch("/api/pages", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(payload),
          });
          return response.json();
        }
        document.querySelector("[data-rename]")?.addEventListener("click", async function () {
          const target = window.prompt("新的路径（例如 content/guide/start.md）", contentPath);
          if (!target || target === contentPath) return;
          const result = await callPages({ action: "rename", path: contentPath, to: target });
          if (result.ok) window.alert("已重命名，站点正在重建（约 3–5 分钟）");
          else window.alert(result.message || "重命名失败");
        });
        document.querySelector("[data-delete]")?.addEventListener("click", async function () {
          if (!window.confirm("删除这一页？删除会生成一次提交，可从 Git 历史找回。")) return;
          const result = await callPages({ action: "delete", path: contentPath });
          if (result.ok) location.href = "/";
          else window.alert(result.message || "删除失败");
        });
      </script>
    )
  }
</Base>
