---
import Base from "../layouts/Base.astro";

export const prerender = false;
Astro.response.status = 404;
---

<Base title="页面不存在">
  <div class="mx-auto max-w-md py-16 text-center">
    <p class="text-5xl font-bold text-stone-300">404</p>
    <h1 class="mt-3 text-[1.9rem] font-light leading-tight tracking-tight">这一页不存在</h1>
    <p class="mt-2 text-sm text-graphite">可能是链接过期，也可能是页面被改名或删除。</p>
    <div class="mt-6 flex justify-center gap-3 text-sm">
      <a href="/" class="rounded-md bg-ink px-3 py-2 text-white hover:bg-black">回首页</a>
      <a href="/search" class="rounded-md border border-stone-300 px-3 py-2 hover:bg-stone-100">搜索</a>
    </div>
  </div>
</Base>
