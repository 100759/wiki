---
import Base from "../../layouts/Base.astro";
import { pathToSlug, slugToPath } from "../../lib/ids";
import { neighbours } from "../../lib/nav";
import { renderPage, stripLeadingTitle } from "../../lib/render";
import { getSession } from "../../lib/session";
import { getStore } from "../../lib/storage";

export const prerender = false;

const slug = Astro.params.slug ?? "";
const contentPath = slugToPath(slug);
if (!contentPath) {
  return new Response("Not found", { status: 404 });
}

const store = getStore();
const page = await store.getPageByPath(contentPath);
if (!page) {
  return new Response("Not found", { status: 404 });
}

const etag = `"${page.sha}"`;
const headers = new Headers({
  "Cache-Control": "public, s-maxage=10, stale-while-revalidate=60",
  ETag: etag,
});

const ifNoneMatch = Astro.request.headers.get("if-none-match");
if (ifNoneMatch && ifNoneMatch.split(",").some((tag) => tag.trim() === etag)) {
  return new Response(null, { status: 304, headers });
}

Astro.response.headers.set("Cache-Control", headers.get("Cache-Control")!);
Astro.response.headers.set("ETag", etag);

const { html, toc } = renderPage(stripLeadingTitle(page.markdown, page.title));
const session = getSession(Astro.cookies);
const canEdit = Boolean(session && session.role !== "viewer");
const { prev, next } = neighbours(await store.listPages(), page.path);

const rel = page.path.replace(/^content\//, "").replace(/\.md$/, "");
const crumbs = rel === "index" ? [] : rel.split("/").slice(0, -1);
const updated = new Date(page.updatedAt);
---

<Base title={page.title} activePath={page.path}>
  <article class="max-w-content py-10">
    <nav class="flex flex-wrap items-center gap-2">
      <span class="label">Wiki</span>
      {crumbs.map((crumb) => (
        <>
          <span class="label">/</span>
          <span class="label">{crumb}</span>
        </>
      ))}
    </nav>

    <h1 class="mt-6 text-[2.4rem] font-light leading-[1.15] tracking-tight text-ink">{page.title}</h1>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-hairline pb-6">
      <span class="label">
        {page.updatedAt === new Date(0).toISOString()
          ? "内置页面"
          : `更新于 ${updated.toLocaleDateString("zh-CN")}`}
      </span>
      {canEdit && (
        <span class="flex items-center gap-4 text-[12px] text-graphite">
          <a href={`/edit?path=${encodeURIComponent(page.path)}`} class="transition-colors hover:text-ink">
            编辑
          </a>
          <a
            href={`/ask?path=${encodeURIComponent(page.path)}`}
            class="transition-colors hover:text-ink"
          >
            问 AI
          </a>
          <button type="button" data-rename class="transition-colors hover:text-ink">重命名</button>
          <button type="button" data-delete class="text-stone-400 transition-colors hover:text-red-600">
            删除
          </button>
        </span>
      )}
    </div>

    {
      toc.length > 1 && (
        <nav class="mt-8 border-l border-hairline pl-4">
          <p class="label mb-2">本页</p>
          <ul class="space-y-1.5">
            {toc.map((item) => (
              <li style={`margin-left: ${(item.level - 2) * 10}px`}>
                <a href={`#${item.id}`} class="text-[13px] text-graphite transition-colors hover:text-ink">
                  {item.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="wiki-prose mt-10" set:html={html} />

    <nav class="mt-16 grid grid-cols-2 gap-6 border-t border-hairline pt-6">
      {
        prev ? (
          <a href={`/w/${prev.slug}`} class="group min-w-0">
            <span class="label block">上一篇</span>
            <span class="mt-1 block truncate text-[14px] text-ink group-hover:underline">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`/w/${next.slug}`} class="group min-w-0 text-right">
            <span class="label block">下一篇</span>
            <span class="mt-1 block truncate text-[14px] text-ink group-hover:underline">{next.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>

  {
    canEdit && (
      <script define:vars={{ contentPath }} is:inline>
        async function callPages(payload) {
          const response = await fetch("/api/pages", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(payload),
          });
          return response.json();
        }
        document.querySelector("[data-rename]")?.addEventListener("click", async function () {
          const target = window.prompt("新的路径（例如 content/guide/start.md）", contentPath);
          if (!target || target === contentPath) return;
          const result = await callPages({ action: "rename", path: contentPath, to: target });
          if (result.ok) {
            location.href = "/w/" + target.replace(/^content\//, "").replace(/\.md$/, "").split("/").join(".");
          } else {
            window.alert(result.message || "重命名失败");
          }
        });
        document.querySelector("[data-delete]")?.addEventListener("click", async function () {
          if (!window.confirm("删除这一页？删除会生成一次提交，可从 Git 历史找回。")) return;
          const result = await callPages({ action: "delete", path: contentPath });
          if (result.ok) location.href = "/";
          else window.alert(result.message || "删除失败");
        });
      </script>
    )
  }
</Base>
