---
import Base from "../../layouts/Base.astro";
import type { NavItem } from "../../lib/nav";
import { buildNav, neighbours } from "../../lib/nav";
import { readLocalPage, readLocalPages } from "../../lib/content-fs";
import { pathToSlug } from "../../lib/ids";
import { renderPage, stripLeadingTitle } from "../../lib/render";
import type { PageSummary } from "../../lib/storage";

export const prerender = true;

export async function getStaticPaths() {
  const pages = await readLocalPages();
  const nav: NavItem[] = buildNav(pages);
  return pages.map((summary: PageSummary) => ({
    params: { slug: pathToSlug(summary.path) },
    props: { summary, nav, pages },
  }));
}

const { summary, nav, pages } = Astro.props as {
  summary: PageSummary;
  nav: NavItem[];
  pages: PageSummary[];
};

const page = await readLocalPage(summary.path);
if (!page) {
  return new Response("Not found", { status: 404 });
}

const { html, toc } = renderPage(stripLeadingTitle(page.markdown, page.title));
const { prev, next } = neighbours(pages, page.path);

const rel = page.path.replace(/^content\//, "").replace(/\.md$/, "");
const crumbs = rel === "index" ? [] : rel.split("/").slice(0, -1);
const updated = new Date(page.updatedAt);
---

<Base title={page.title} activePath={page.path} nav={nav}>
  <article class="max-w-content py-10">
    <nav class="flex flex-wrap items-center gap-2">
      <span class="label">Wiki</span>
      {crumbs.map((crumb) => (
        <>
          <span class="label">/</span>
          <span class="label">{crumb}</span>
        </>
      ))}
    </nav>

    <h1 class="mt-6 text-[2.4rem] font-light leading-[1.15] tracking-tight text-ink">{page.title}</h1>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-hairline pb-6">
      <span class="label">
        {page.updatedAt === new Date(0).toISOString()
          ? "内置页面"
          : `更新于 ${updated.toLocaleDateString("zh-CN")}`}
      </span>
      <a
        href={`/ask?path=${encodeURIComponent(page.path)}`}
        class="text-[12px] text-graphite transition-colors hover:text-ink"
      >
        问 AI
      </a>
      <span id="saved-notice" hidden class="rounded bg-mist px-2 py-1 text-[11px] text-graphite">
        内容已保存，站点正在重建，几分钟后这里会更新
      </span>
    </div>

    {
      toc.length > 1 && (
        <nav class="mt-8 border-l border-hairline pl-4">
          <p class="label mb-2">本页</p>
          <ul class="space-y-1.5">
            {toc.map((item) => (
              <li style={`margin-left: ${(item.level - 2) * 10}px`}>
                <a href={`#${item.id}`} class="text-[13px] text-graphite transition-colors hover:text-ink">
                  {item.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="wiki-prose mt-10" set:html={html} />

    <nav class="mt-16 grid grid-cols-2 gap-6 border-t border-hairline pt-6">
      {
        prev ? (
          <a href={`/w/${prev.slug}`} class="group min-w-0">
            <span class="label block">上一篇</span>
            <span class="mt-1 block truncate text-[14px] text-ink group-hover:underline">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`/w/${next.slug}`} class="group min-w-0 text-right">
            <span class="label block">下一篇</span>
            <span class="mt-1 block truncate text-[14px] text-ink group-hover:underline">{next.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>

  <script is:inline data-astro-rerun>
    (function () {
      if (location.search.indexOf("saved=1") < 0) return;
      var notice = document.getElementById("saved-notice");
      if (notice) notice.hidden = false;
    })();
  </script>
</Base>
