---
import Base from "../../layouts/Base.astro";
import { pathToSlug, slugToPath } from "../../lib/ids";
import { neighbours } from "../../lib/nav";
import { renderPage } from "../../lib/render";
import { getSession } from "../../lib/session";
import { getStore } from "../../lib/storage";

export const prerender = false;

const slug = Astro.params.slug ?? "";
const contentPath = slugToPath(slug);
if (!contentPath) {
  return new Response("Not found", { status: 404 });
}

const store = getStore();
const page = await store.getPageByPath(contentPath);
if (!page) {
  return new Response("Not found", { status: 404 });
}

const etag = `"${page.sha}"`;
const headers = new Headers({
  "Cache-Control": "public, s-maxage=10, stale-while-revalidate=60",
  ETag: etag,
});

const ifNoneMatch = Astro.request.headers.get("if-none-match");
if (ifNoneMatch && ifNoneMatch.split(",").some((tag) => tag.trim() === etag)) {
  return new Response(null, { status: 304, headers });
}

Astro.response.headers.set("Cache-Control", headers.get("Cache-Control")!);
Astro.response.headers.set("ETag", etag);

const { html, toc } = renderPage(page.markdown);
const session = getSession(Astro.cookies);
const canEdit = Boolean(session && session.role !== "viewer");
const { prev, next } = neighbours(await store.listPages(), page.path);

const rel = page.path.replace(/^content\//, "").replace(/\.md$/, "");
const crumbs = rel === "index" ? [] : rel.split("/").slice(0, -1);
const updated = new Date(page.updatedAt);
---

<Base title={page.title} activePath={page.path}>
  <article class="rounded-lg border border-stone-200 bg-white px-5 py-7 sm:px-8">
    <nav class="mb-3 flex flex-wrap items-center gap-1 text-xs text-stone-400">
      <a href="/" class="hover:text-ink">首页</a>
      {crumbs.map((crumb, index) => (
        <>
          <span>/</span>
          <span>{crumb}</span>
        </>
      ))}
    </nav>

    <header class="mb-6 border-b border-stone-100 pb-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <h1 class="text-2xl font-bold">{page.title}</h1>
        {canEdit && (
          <div class="flex items-center gap-2 text-xs">
            <a
              href={`/edit?path=${encodeURIComponent(page.path)}`}
              class="rounded-md border border-stone-300 px-2 py-1 hover:bg-stone-100"
            >
              编辑
            </a>
            <button type="button" data-rename class="rounded-md border border-stone-300 px-2 py-1 hover:bg-stone-100">
              重命名
            </button>
            <button
              type="button"
              data-delete
              class="rounded-md border border-red-300 px-2 py-1 text-red-700 hover:bg-red-50"
            >
              删除
            </button>
          </div>
        )}
      </div>
      <p class="mt-2 text-xs text-stone-400">
        <code>{page.path}</code> · 最近由 {page.updatedBy} 更新
        {page.updatedAt === new Date(0).toISOString() ? "" : `于 ${updated.toLocaleString("zh-CN")}`}
      </p>
    </header>

    {
      toc.length > 1 && (
        <details class="mb-5 rounded-md border border-stone-200 bg-stone-50 px-3 py-2 text-sm" open>
          <summary class="cursor-pointer text-xs text-stone-500">本页目录</summary>
          <ul class="mt-2 space-y-1">
            {toc.map((item) => (
              <li style={`padding-left: ${(item.level - 2) * 0.9}rem`}>
                <a href={`#${item.id}`} class="text-stone-600 hover:text-ink">
                  {item.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    <div class="wiki-prose" set:html={html} />

    <nav class="mt-8 flex items-stretch justify-between gap-3 border-t border-stone-100 pt-4 text-sm">
      {
        prev ? (
          <a href={`/w/${prev.slug}`} class="min-w-0 hover:text-ink">
            <span class="block text-xs text-stone-400">上一篇</span>
            <span class="block truncate">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`/w/${next.slug}`} class="min-w-0 text-right hover:text-ink">
            <span class="block text-xs text-stone-400">下一篇</span>
            <span class="block truncate">{next.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>

  {
    canEdit && (
      <script define:vars={{ contentPath }} is:inline>
        async function callPages(payload) {
          const response = await fetch("/api/pages", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(payload),
          });
          return response.json();
        }
        document.querySelector("[data-rename]")?.addEventListener("click", async function () {
          const target = window.prompt("新的路径（例如 content/guide/start.md）", contentPath);
          if (!target || target === contentPath) return;
          const result = await callPages({ action: "rename", path: contentPath, to: target });
          if (result.ok) {
            location.href = "/w/" + target.replace(/^content\//, "").replace(/\.md$/, "").split("/").join(".");
          } else {
            window.alert(result.message || "重命名失败");
          }
        });
        document.querySelector("[data-delete]")?.addEventListener("click", async function () {
          if (!window.confirm("删除这一页？删除会生成一次提交，可从 Git 历史找回。")) return;
          const result = await callPages({ action: "delete", path: contentPath });
          if (result.ok) location.href = "/";
          else window.alert(result.message || "删除失败");
        });
      </script>
    )
  }
</Base>
