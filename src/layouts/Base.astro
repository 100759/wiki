---
import "../styles/global.css";
import { getSession } from "../lib/session";

interface Props {
  title?: string;
}

const { title = "共创 Wiki" } = Astro.props;
const session = getSession(Astro.cookies);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · 共创 Wiki</title>
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased">
    <header class="border-b border-stone-200 bg-white/80 backdrop-blur">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-3 px-4 py-3">
        <a href="/" class="mr-2 text-lg font-bold tracking-tight">共创 Wiki</a>
        <a href="/" class="text-sm text-stone-600 hover:text-ink">全部页面</a>
        <a href="/edit?path=content/new-page.md" class="text-sm text-stone-600 hover:text-ink">新建页面</a>

        <div class="ml-auto flex items-center gap-2 text-xs text-stone-500">
          {
            session ? (
              <>
                <span>
                  {session.name}
                  <span class="ml-1 rounded bg-stone-100 px-1.5 py-0.5 text-[11px] text-stone-500">
                    {session.role}
                  </span>
                </span>
                <button
                  type="button"
                  id="logout"
                  class="rounded-md border border-stone-300 px-2 py-1 text-stone-600 hover:bg-stone-100"
                >
                  退出
                </button>
              </>
            ) : (
              <a href="/login" class="rounded-md border border-stone-300 px-2 py-1 text-stone-600 hover:bg-stone-100">
                登录
              </a>
            )
          }
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>

    <footer class="mx-auto max-w-5xl px-4 pb-10 pt-4 text-xs text-stone-400">
      读者免登录阅读 · 保存需登录 · 正文与历史都存在 GitHub 仓库
    </footer>

    {
      session && (
        <script is:inline>
          document.getElementById("logout")?.addEventListener("click", async function () {
            await fetch("/api/logout", { method: "POST" });
            location.href = "/";
          });
        </script>
      )
    }
  </body>
</html>
