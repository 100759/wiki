---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { getSession } from "../lib/session";
import { buildNav } from "../lib/nav";
import { getStore } from "../lib/storage";

interface Props {
  title?: string;
  /** 阅读页/编辑页展示左侧导航；登录页等可以关掉。 */
  sidebar?: boolean;
  activePath?: string;
}

const { title = "共创 Wiki", sidebar = true, activePath } = Astro.props;
const session = getSession(Astro.cookies);
const pages = sidebar ? await getStore().listPages() : [];
const nav = buildNav(pages);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title} · 共创 Wiki</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased">
    <header transition:persist class="sticky top-0 z-20 border-b border-hairline bg-paper/90 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-6">
        <a href="/" class="text-[13px] font-medium uppercase tracking-label text-ink">共创 Wiki</a>

        <form action="/search" method="get" class="hidden flex-1 sm:block">
          <input
            type="search"
            name="q"
            placeholder="搜索"
            class="w-full max-w-xs border-0 border-b border-transparent bg-transparent px-0 py-1 text-[13px] text-ink placeholder:text-stone-400 focus:border-ink focus:outline-none"
          />
        </form>

        <nav class="ml-auto flex items-center gap-6 text-[13px] text-graphite">
          <a href="/ask" class="transition-colors hover:text-ink">问 AI</a>
          <a href="/edit?path=content/new-page.md" class="hidden transition-colors hover:text-ink sm:inline">新建</a>
          {
            session ? (
              <>
                <a href="/account" class="hidden text-[13px] transition-colors hover:text-ink sm:inline">
                  {session.name}
                </a>
                {session.role === "admin" && (
                  <a href="/admin/users" class="hidden text-[13px] transition-colors hover:text-ink sm:inline">
                    成员
                  </a>
                )}
                <button
                  type="button"
                  id="logout"
                  class="text-[13px] text-graphite transition-colors hover:text-ink"
                >
                  退出
                </button>
              </>
            ) : (
              <a
                href="/login"
                class="border border-ink px-4 py-1.5 text-[12px] uppercase tracking-label text-ink transition-colors hover:bg-ink hover:text-paper"
              >
                登录
              </a>
            )
          }
        </nav>
      </div>
    </header>

    <div class="mx-auto flex max-w-6xl gap-12 px-6">
      {
        sidebar && (
          <aside transition:persist class="hidden w-52 shrink-0 lg:block">
            <nav class="sticky top-24 space-y-px py-10">
              <p class="label mb-3">目录</p>
              {nav.map((item) => (
                <a
                  href={`/w/${item.slug}`}
                  class:list={[
                    "block truncate border-l py-1.5 pl-3 text-[13px] leading-6 transition-colors",
                    item.path === activePath
                      ? "border-ink text-ink"
                      : "border-transparent text-graphite hover:border-stone-300 hover:text-ink",
                  ]}
                  style={`margin-left: ${item.depth * 12}px`}
                  title={item.path}
                >
                  {item.title}
                </a>
              ))}
              {nav.length === 0 && <p class="pl-3 text-[13px] text-stone-400">还没有页面</p>}
            </nav>
          </aside>
        )
      }

      <main class="min-w-0 flex-1">
        <slot />
      </main>
    </div>

    <footer class="mx-auto max-w-6xl px-6 pb-12 pt-16">
      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-hairline pt-6">
        <p class="label">共创 Wiki</p>
        <p class="label">内容存于 GitHub · 免登录阅读</p>
      </div>
    </footer>

    <script is:inline data-astro-rerun>
      // 悬停预取：Astro 自带策略在这个项目里没生效，这里用事件委托自己挂。
      if (!window.__prefetchBound) {
        window.__prefetchBound = true;
        const seen = new Set();
        document.addEventListener(
          "pointerover",
          function (event) {
            const link = event.target && event.target.closest ? event.target.closest('a[href^="/"]') : null;
            if (!link) return;
            const href = link.getAttribute("href");
            if (!href || seen.has(href) || seen.size > 40) return;
            if (href.startsWith("/api/") || href.startsWith("/img/") || href.startsWith("/_astro/")) return;
            seen.add(href);
            const preload = document.createElement("link");
            preload.rel = "prefetch";
            preload.href = href;
            preload.as = "document";
            document.head.appendChild(preload);
          },
          { passive: true },
        );
      }
    </script>

    {
      session && (
        <script is:inline data-astro-rerun>
          document.getElementById("logout")?.addEventListener("click", async function () {
            await fetch("/api/logout", { method: "POST" });
            location.href = "/";
          });
        </script>
      )
    }
  </body>
</html>
