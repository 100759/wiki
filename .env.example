# M1 本地运行不需要任何密钥。

# 图片读取模式：public（默认，302 到 raw.githubusercontent.com）| private（M2，M1 返回 not_implemented）
IMAGE_MODE=public

# public 模式拼 raw 地址用；M1 不会真的请求 GitHub（需真实仓库时替换为 owner/repo）
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main

# 数据根目录（默认 ./data）
WIKI_DATA_DIR=./data

# ---- 以下留给 M2，M1 不读取 ----
# GITHUB_TOKEN=
# JWT_SECRET=
