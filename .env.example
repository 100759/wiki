# 本地不填任何密钥也能跑：无 GITHUB_TOKEN 时存储退回 ./data（只读演示用）
# 线上必须配 GITHUB_REPO + GITHUB_TOKEN + JWT_SECRET

# 图片读取模式：public（302 到 raw.githubusercontent.com）| private（未实现，返回 501）
IMAGE_MODE=public

# 唯一真源仓库（owner/repo）
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main

# 细粒度 PAT，权限 Contents: Read and write，只授权该仓库
GITHUB_TOKEN=

# 会话签名密钥，至少 16 字符；缺失时登录直接拒绝（不会降级）
JWT_SECRET=

# 首次部署引导管理员口令：用户表为空时用它登录 admin，成功后写入 _system/users.json
WIKI_BOOTSTRAP_PASSWORD=

# 诊断端点 /api/_probe 的开关：不配则一律 404
PROBE_TOKEN=

# 本地存储根目录（无 GitHub 凭据时使用）
WIKI_DATA_DIR=./data

# 仅本地调试：GitHub 走本机代理
# GITHUB_PROXY=http://127.0.0.1:7897
